    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst now = new Date();\nconst end = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()));\nconst start = cfg.backfillFrom\n  ? new Date(cfg.backfillFrom + 'T00:00:00Z')\n  : new Date(end.getTime() - Number(cfg.lookbackDays) * 86400000);\nconst fmt = d => d.toISOString().slice(0, 10);\nconst items = [];\nlet cur = new Date(Date.UTC(start.getUTCFullYear(), start.getUTCMonth(), start.getUTCDate()));\nwhile (cur <= end) {\n  const monthEnd = new Date(Date.UTC(cur.getUTCFullYear(), cur.getUTCMonth() + 1, 0));\n  const to = monthEnd < end ? monthEnd : end;\n  items.push({ json: { from: fmt(cur), to: fmt(to) } });\n  cur = new Date(Date.UTC(cur.getUTCFullYear(), cur.getUTCMonth() + 1, 1));\n}\nreturn items;"
      },
