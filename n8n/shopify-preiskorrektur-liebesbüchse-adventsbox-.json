        "jsCode": "const resp = $input.item.json;\nconst setQty = resp?.data?.orderEditSetQuantity;\nconst errs = setQty?.userErrors || [];\nif (errs.length) {\n  throw new Error('orderEditSetQuantity userErrors: ' + JSON.stringify(errs));\n}\n\nreturn {\n  json: {\n    ...$('Add-Ergebnis prüfen').item.json,\n    oldPositionRemoved: true,\n    removedLineItem: setQty?.calculatedLineItem || null\n  }\n};"
