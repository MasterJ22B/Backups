    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\n\nconst body = {\n  query: `mutation orderEditAddVariant($id: ID!, $variantId: ID!, $quantity: Int!, $allowDuplicates: Boolean) {\n    orderEditAddVariant(id: $id, variantId: $variantId, quantity: $quantity, allowDuplicates: $allowDuplicates) {\n      calculatedLineItem {\n        id\n        title\n        sku\n        variantTitle\n        discountedUnitPriceSet { shopMoney { amount currencyCode } }\n      }\n      userErrors { field message }\n    }\n  }`,\n  variables: {\n    id: item.calcOrderId,\n    variantId: item.variantId,\n    quantity: 1,\n    allowDuplicates: true\n  }\n};\n\nreturn {\n  json: {\n    ...item,\n    accessToken: $('Token holen 2').item.json.access_token,\n    gqlBody: JSON.stringify(body)\n  }\n};"
      },
