      "parameters": {
        "jsCode": "const shop = 'vdzvc0-nd';\n\nconst createdMin = DateTime.now().setZone('Europe/Berlin').minus({ days: 30 }).startOf('day').plus({ hours: 6 }).toISO();\nconst createdMax = DateTime.now().setZone('Europe/Berlin').startOf('day').plus({ hours: 6 }).toISO();\n\nconst initUrlB = `https://${shop}.myshopify.com/admin/api/2024-10/orders.json`\n  + `?status=any`\n  + `&limit=250`\n  + `&fields=id,name,tags`\n  + `&created_at_min=${encodeURIComponent(createdMin)}`\n  + `&created_at_max=${encodeURIComponent(createdMax)}`;\n\n// Globales Array leeren\nconst staticData = $getWorkflowStaticData('global');\nstaticData.collectedOrdersB = [];\n\nreturn [{\n  json: {\n    nextUrl: initUrlB,\n    hasNext: true\n  }\n}];"
      },
