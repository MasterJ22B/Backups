      "id": "15dd4168-4487-44e8-b41f-b536ce3a2de8",
      "name": "Kurz pausieren",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1792,
        512
      ],
      "webhookId": "215ebf7a-b538-4aa1-95e5-dd5e896a695d"
    },
    {
      "parameters": {
        "jsCode": "const s=$getWorkflowStaticData('global');\nconst summary={zeile:'ZUSAMMENFASSUNG',total_ok:s.ok||0,total_fail:s.fail||0,finished_at:new Date().toISOString()};\nconst fails=(s.failRows||[]).map(r=>({json:{zeile:'FEHLER',email:r.email,http_status:r.http_status,sent_at:r.sent_at}}));\ns.ok=0;s.fail=0;s.failRows=[];\nreturn [{json:summary},...fails];"
      },
