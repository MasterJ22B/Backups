    {
      "parameters": {
        "jsCode": "// Bereitet je gefundene Position EIN Item vor\nconst staticData = $getWorkflowStaticData('global');\nconst collected = staticData.toFix || [];\n\nconst out = [];\nfor (const order of collected) {\n  for (const pos of order.positionen) {\n    out.push({\n      json: {\n        orderId: order.orderId,\n        variantId: `gid://shopify/ProductVariant/${pos.variantId}`,\n        orderName: order.orderName,\n        oldLineItemGid: `gid://shopify/CalculatedLineItem/${pos.lineItemId}`,\n        orderGid: `gid://shopify/Order/${order.orderId}`,\n        sku: pos.sku\n      }\n    });\n  }\n}\n\nreturn out;"
      },
