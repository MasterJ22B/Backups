    {
      "parameters": {
        "jsCode": "const s = $getWorkflowStaticData('global');\nconst max = $('Config').first().json.maxDhlAbfragen;\n// älteste zuerst, Limit wegen DHL-Tageskontingent\nconst liste = (s.kandidaten || [])\n  .sort((a, b) => a.orderDatum.localeCompare(b.orderDatum))\n  .slice(0, max);\nreturn liste.map(k => ({ json: k }));"
      },
