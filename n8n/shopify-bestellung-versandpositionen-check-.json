    {
      "parameters": {
        "jsCode": "const order = $input.first().json.order || {};\nconst shippingLines = order.shipping_lines || [];\n\n// Alle Versandpositionen aus shipping_lines sammeln\nconst versandpositionen = shippingLines.map(sl => ({\n  shippingLineId: sl.id,\n  title: sl.title,\n  code: sl.code,\n  price: sl.price,\n  source: sl.source,\n  isRemoved: sl.is_removed,\n  steuersaetze: (sl.tax_lines || []).map(tl => ({\n    title: tl.title,\n    rate: tl.rate,\n    price: tl.price,\n  })),\n}));\n\nreturn [{\n  json: {\n    orderId: order.id,\n    orderName: order.name,\n    hatVersandpositionen: versandpositionen.length > 0,\n    anzahlVersandpositionen: versandpositionen.length,\n    versandpositionen,\n  }\n}];"
      },
