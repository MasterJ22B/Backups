    {
      "parameters": {
        "jsCode": "// CSV-Vorbereitung: eine Zeile pro Teilposition\nconst staticData = $getWorkflowStaticData('global');\nconst collected = staticData.toFix || [];\n\nconst zielPreise = {\n  buecher: '42.00',\n  goodies: '26.99'\n};\n\nconst rows = [];\nfor (const order of collected) {\n  for (const pos of order.positionen) {\n    rows.push({\n      orderId: order.orderId,\n      orderName: order.orderName,\n      createdAt: order.createdAt,\n      typ: pos.typ,\n      sku: pos.sku,\n      title: pos.title,\n      lineItemId: pos.lineItemId,\n      quantity: pos.quantity,\n      aktuellerPreis: pos.aktuellerPreis,\n      zielPreis: zielPreise[pos.typ] || '',\n      newVariantId: pos.newVariantId\n    });\n  }\n}\n\nreturn rows.map(r => ({ json: r }));"
      },
