        "shopifyAccessTokenApi": {
          "id": "zxKNp58HJZZkXMJx",
          "name": "BB AccessKey"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const topProducts = $('JSONL parsen & Top N ermitteln').all().map(i => i.json.productId);\nconst taggedResponse = $input.first().json;\nconst taggedEdges = taggedResponse?.data?.products?.edges || [];\nconst currentlyTagged = taggedEdges.map(e => e.node.id);\n\nconst toAdd = topProducts.filter(id => !currentlyTagged.includes(id));\nconst toRemove = currentlyTagged.filter(id => !topProducts.includes(id));\n\nconst output = [\n  ...toAdd.map(id => ({ json: { productId: id, action: 'add' } })),\n  ...toRemove.map(id => ({ json: { productId: id, action: 'remove' } })),\n];\n\nreturn output;"
      },
