      "id": "63d8b073-5a80-4189-90dc-40ec830ba06f",
      "name": "GET Kunden ",
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst customers = response.body?.customers || response.customers || [];\nconst linkHeader = response.headers?.link || '';\n\nconst staticData = $getWorkflowStaticData('global');\nif (!Array.isArray(staticData.toFix)) {\n  staticData.toFix = [];\n}\n\n// Prüft, ob ein Namensfeld ein Platzhalter ist:\n// \"FirstName\" / \"LastName\" oder von Klammern umschlossen z.B. \"(Vorname)\"\nfunction istPlatzhalter(value) {\n  if (!value) return false;\n  const v = String(value).trim();\n  if (v.toLowerCase() === 'firstname') return true;\n  if (v.toLowerCase() === 'lastname') return true;\n  if (/^\\(.*\\)$/.test(v)) return true;\n  return false;\n}\n\n// Kunden mit fehlerhaftem Vor- ODER Nachnamen sammeln\nfor (const customer of customers) {\n  const first = customer.first_name;\n  const last = customer.last_name;\n  const email = customer.email;\n\n  // Ohne E-Mail kein DB-Match möglich -> überspringen\n  if (!email) continue;\n\n  if (istPlatzhalter(first) || istPlatzhalter(last)) {\n    staticData.toFix.push({\n      customerId: customer.id,\n      email: email,\n      firstNameAlt: first || null,\n      lastNameAlt: last || null,\n    });\n  }\n}\n\n// Next URL extrahieren\nconst nextMatch = linkHeader\n  .split(',')\n  .find(s => s.includes('rel=\"next\"'));\nconst nextUrl = nextMatch ? nextMatch.match(/<(.+?)>/)?.[1] : null;\n\nreturn [{\n  json: {\n    nextUrl: nextUrl,\n    hasNext: !!nextUrl,\n    collectedCount: staticData.toFix.length\n  }\n}];"
      },
