      "parameters": {
        "jsCode": "const orderGid = 'gid://shopify/Order/7576484053107';\n\nconst body = {\n  query: `{ order(id: \"${orderGid}\") { id name lineItems(first: 50) { edges { node { id title sku quantity merchantEditable originalUnitPriceSet { shopMoney { amount currencyCode } } contract { id } sellingPlan { name } } } } } }`\n};\n\nreturn [{\n  json: {\n    accessToken: $('Token holen ').item.json.access_token,\n    gqlBody: JSON.stringify(body)\n  }\n}];"
      },
