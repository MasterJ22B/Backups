    {
      "parameters": {
        "jsCode": "const op = $input.first().json.data.currentBulkOperation;\nif (op.status === 'FAILED' || op.status === 'CANCELED' || op.status === 'EXPIRED') {\n  throw new Error('Bulk Operation fehlgeschlagen: ' + op.status + ' (' + (op.errorCode || 'kein Fehlercode') + ')');\n}\nreturn [{ json: op }];"
      },
