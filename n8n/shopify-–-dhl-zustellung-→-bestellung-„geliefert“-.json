      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        2144,
        544
      ],
      "id": "786d78e6-92dc-4dbe-abc7-cf1033f9d92f",
      "name": "DHL Tracking abfragen",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const k = $('Einzeln abarbeiten').item.json;\nconst cfg = $('Config').first().json;\nconst r = $input.first().json;\nconst s = $getWorkflowStaticData('global');\n\nlet dhlStatus = 'fehler', zugestelltAm = null, info = '';\nif (r.statusCode === 200 && r.body?.shipments?.length) {\n  const sh = r.body.shipments[0];\n  dhlStatus = sh.status?.statusCode || 'unknown';     // pre-transit | transit | delivered | failure | unknown\n  info = sh.status?.description || sh.status?.status || '';\n  if (dhlStatus === 'delivered') zugestelltAm = sh.status?.timestamp || null;\n} else if (r.statusCode === 404) {\n  dhlStatus = 'nicht_gefunden';\n} else if (r.statusCode === 429) {\n  throw new Error('DHL Rate-Limit erreicht (429) – Lauf abgebrochen, später erneut starten.');\n} else {\n  info = 'HTTP ' + r.statusCode;\n}\n\nlet aktion = 'nichts';\nif (dhlStatus === 'delivered') {\n  aktion = cfg.dryRun ? 'dryrun' : 'geliefert';\n} else if (cfg.modus === 'backfill' && ['nicht_gefunden', 'failure', 'unknown'].includes(dhlStatus)) {\n  // Altbestand, den DHL nicht als zugestellt meldet -> markieren, damit er nicht jedes Mal erneut abgefragt wird\n  aktion = cfg.dryRun ? 'dryrun' : 'markieren';\n}\n\n// happenedAt: DHL-Zeitpunkt, sonst jetzt\nconst happenedAt = zugestelltAm ? new Date(zugestelltAm).toISOString() : new Date().toISOString();\n\nconst zeile = { ...k, dhlStatus, dhlInfo: info, zugestelltAm, aktion, happenedAt };\ns.report.push(zeile);\nreturn [{ json: zeile }];"
      },
