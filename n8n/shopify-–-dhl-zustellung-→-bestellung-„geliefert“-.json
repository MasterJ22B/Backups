    {
      "parameters": {
        "url": "https://api-eu.dhl.com/track/shipments",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "trackingNumber",
              "value": "={{ $json.trackingNummer }}"
