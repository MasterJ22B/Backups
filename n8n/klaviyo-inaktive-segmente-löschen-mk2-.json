        "jsCode": "// n8n Function node (Run Once for Each Item)\n// Erwartet pro Item: { profileId, email }\n\nconst profileId = $json.profileId?.trim();\nconst email = $json.email?.trim();\n\nif (!email && !profileId) {\n  throw new Error('Kein Identifier vorhanden: email oder profileId fehlt.');\n}\n\nreturn {\n  ...$json,\n  data: {\n    type: 'data-privacy-deletion-job',\n    attributes: {\n      profile: {\n        data: {\n          type: 'profile',\n          attributes: email ? { email } : { id: profileId },\n        },\n      },\n    },\n  },\n};\n"
