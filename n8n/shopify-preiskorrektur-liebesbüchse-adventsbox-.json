      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst orders = response.body?.orders || response.orders || [];\nconst staticData = $getWorkflowStaticData('global');\nif (!Array.isArray(staticData.toFix)) {\n  staticData.toFix = [];\n}\n// SKU -> { falscherPreis }  (richtige Preise sind bereits in den Varianten hinterlegt)\nconst TARGETS = {\n  'LB-A-2026-01': { falscherPreis: 43.00 },\n  'LB-A-2026-02': { falscherPreis: 25.99 }\n};\nlet maxId = 0;\nfor (const order of orders) {\n  if (order.id > maxId) maxId = order.id;\n  const lineItems = order.line_items || [];\n  const matchingLines = lineItems.filter(li => {\n    const sku = String(li.sku || '').trim();\n    const target = TARGETS[sku];\n    if (!target) return false;\n    return Number(li.price) === target.falscherPreis;\n  });\n  if (matchingLines.length > 0) {\n    staticData.toFix.push({\n      orderId: order.id,\n      orderName: order.name,\n      createdAt: order.created_at,\n      positionen: matchingLines.map(li => ({\n        lineItemId: li.id,\n        title: li.title,\n        variantId: li.variant_id,\n        sku: li.sku,\n        aktuellerPreis: li.price,\n        quantity: li.quantity\n      }))\n    });\n  }\n}\n// Nächste Seite über since_id = höchste gesehene ID\nconst shop = 'vdzvc0-nd';\nconst sinceA = '2026-05-30T00:00:00Z';\nconst untilA = '2026-06-26T00:00:00Z';\nlet nextUrl = null;\nif (orders.length === 250) {\n  nextUrl = `https://${shop}.myshopify.com/admin/api/2024-10/orders.json`\n    + `?limit=250`\n    + `&status=any`\n    + `&created_at_min=${encodeURIComponent(sinceA)}`\n    + `&created_at_max=${encodeURIComponent(untilA)}`\n    + `&since_id=${maxId}`\n    + `&fields=id,name,created_at,tags,line_items`;\n}\nreturn [{\n  json: {\n    nextUrl: nextUrl,\n    hasNext: !!nextUrl,\n    collectedCount: staticData.toFix.length\n  }\n}];"
      },
