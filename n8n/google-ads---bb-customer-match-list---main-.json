    {
      "parameters": {
        "jsCode": "// n8n Code Node – Mode: \"Run Once for All Items\"\n// Muss zur FETCH-Größe in \"Microsoft SQL – Seite\" im Sub-Workflow passen.\nconst PAGE_SIZE = 10000;\n\nconst total = Number($input.first().json.total);\n\nconst seiten = [];\nfor (let offset = 0; offset < total; offset += PAGE_SIZE) {\n  seiten.push({ json: { offset } });\n}\n\nreturn seiten;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -16,
        32
      ],
      "id": "ccdb30f0-960d-4576-a04e-547c630143ce",
      "name": "Code – Seiten erzeugen"
    },
    {
      "parameters": {
        "jsCode": "// n8n Code Node – Mode: \"Run Once for All Items\"\n// Setzt die CSV-Teile der Seiten in Eingangsreihenfolge zusammen.\nconst HEADER = 'Email,First Name,Last Name,Country,Zip,Phone';\n\nconst chunks = items\n  .map(item => item.json.csv)\n  .filter(chunk => chunk);\n\nconst csv = [HEADER, ...chunks].join('\\n');\n\nconst data = await this.helpers.prepareBinaryData(\n  Buffer.from(csv, 'utf8'),\n  'bb-customer-match-list.csv',\n  'text/csv'\n);\n\nreturn [{ json: {}, binary: { data } }];"
      },
