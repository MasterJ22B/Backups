        "query": "SELECT account, access_token, expires_at, DATEDIFF(expires_at, NOW()) AS days_remaining FROM instagram_tokens WHERE account IN ('BB', 'LEAF') ORDER BY FIELD(account, 'BB', 'LEAF');",
        "options": {}
