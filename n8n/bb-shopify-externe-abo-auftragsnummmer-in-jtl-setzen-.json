    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst orders = response.body?.orders || response.orders || [];\nconst linkHeader = response.headers?.link || '';\n\n// Filter Abo-Bestellungen\nconst filtered = orders.filter(order =>\n  (order.tags || '')\n    .split(',')\n    .map(t => t.trim())\n    .includes('appstle_subscription_recurring_order')\n);\n\n// In globales Array pushen\nconst staticData = $getWorkflowStaticData('global');\nstaticData.collectedOrdersB = (staticData.collectedOrdersB || []).concat(filtered);\n\n// Next URL extrahieren\nconst nextMatch = linkHeader\n  .split(',')\n  .find(s => s.includes('rel=\"next\"'));\nconst nextUrl = nextMatch ? nextMatch.match(/<(.+?)>/)?.[1] : null;\n\nreturn [{\n  json: {\n    nextUrl: nextUrl,\n    hasNext: !!nextUrl,\n    collectedCount: staticData.collectedOrdersB.length\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -992,
        64
      ],
      "id": "22cea99d-eda1-4d37-98c5-c417719189d9",
