    {
      "parameters": {
        "jsCode": "const s = $getWorkflowStaticData('global');\nconst rows = s.report || [];\nconst cfg = $('Config').first().json;\nconst esc = v => String(v ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\nconst z = a => rows.filter(r => r.aktion === a).length;\nconst offen = (s.kandidaten || []).length - rows.length;\n\nif (rows.length === 0 && cfg.modus === 'laufend') return []; // laufender Modus: keine leere Mail\n\nconst tr = rows.map(r => `<tr><td>${esc(r.orderName)}</td><td>${esc(r.trackingNummer)}</td>\n<td>${esc(r.dhlStatus)}</td><td>${esc(r.zugestelltAm)}</td><td>${esc(r.aktion)}</td></tr>`).join('');\n\nconst mailText = `\n<p>Modus: <b>${cfg.modus}</b>${cfg.dryRun ? ' (<b>Testlauf – nichts geändert</b>)' : ''}</p>\n<p>Geprüft: ${rows.length} · auf geliefert gesetzt: ${z('geliefert')} · zur Prüfung getaggt: ${z('markieren')}\n · Testlauf-Treffer: ${z('dryrun')} · noch offen (Limit): ${Math.max(offen,0)}</p>\n<table border=\"1\" cellpadding=\"6\" cellspacing=\"0\" style=\"border-collapse:collapse;font-family:Arial;font-size:13px\">\n<thead><tr><th>Bestellung</th><th>Sendungsnr.</th><th>DHL-Status</th><th>Zugestellt am</th><th>Aktion</th></tr></thead>\n<tbody>${tr}</tbody></table>\n<p>Mit freundlichen Grüßen<br>n8n-Workflow DHL-Zustellabgleich</p>`;\n\nreturn [{ json: { mailText, betreff: `DHL-Zustellabgleich (${cfg.modus}${cfg.dryRun ? ', Testlauf' : ''}): ${z('geliefert')} geliefert` } }];"
      },
