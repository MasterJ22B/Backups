  "nodes": [
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  user_email as Email,\n  MAX(CASE WHEN meta_key = 'billing_first_name' THEN meta_value END) as 'First Name',\n  MAX(CASE WHEN meta_key = 'billing_last_name' THEN meta_value END) as 'Last Name',\n  MAX(CASE WHEN meta_key = 'billing_country' THEN meta_value END) as 'Country',\n  MAX(CASE WHEN meta_key = 'billing_postcode' THEN meta_value END) as 'Zip',\n  MAX(CASE WHEN meta_key = 'billing_phone' THEN meta_value END) as 'Phone'\nFROM d034ee28.wp_users users\nJOIN wp_usermeta ON users.ID = wp_usermeta.user_id\nWHERE users.user_status = 0\nGROUP BY users.id;",
        "options": {}
      },
