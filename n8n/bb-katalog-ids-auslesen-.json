      "name": "Merge"
    },
    {
      "parameters": {
        "jsCode": "// Ergebnisse beider Queries aufbereiten:\n// - PriceLists (id, name, currency, catalog.title) -> hilft AT/CH zuzuordnen\n// - Collections (id, title, handle) -> hilft Bücher/Merch zuzuordnen\n// Gibt zusätzlich einen kopierfertigen Config-Block aus.\n\nconst items = $input.all();\n\n// Query-Ergebnisse anhand ihrer Datenstruktur identifizieren (Reihenfolge unabhängig)\nlet priceLists = [];\nlet collections = [];\nfor (const it of items) {\n  const d = it.json?.data || {};\n  if (d.priceLists?.nodes) priceLists = d.priceLists.nodes;\n  if (d.collections?.nodes) collections = d.collections.nodes;\n}\n\nconst plOut = priceLists.map(p => ({\n  id: p.id,\n  name: p.name,\n  currency: p.currency,\n  catalogTitle: p.catalog?.title || null,\n  catalogId: p.catalog?.id || null\n}));\n\nconst colOut = collections.map(c => ({\n  id: c.id,\n  title: c.title,\n  handle: c.handle,\n  produkte: c.productsCount?.count ?? null\n}));\n\n// Best-guess-Vorschläge für die Config (nur Heuristik über Titel/Währung)\nconst findCol = (rx) => (colOut.find(c => rx.test(c.title)) || {}).id || 'gid://shopify/Collection/PLATZHALTER';\nconst findPl = (cur, rx) => (plOut.find(p => p.currency === cur || (p.catalogTitle && rx.test(p.catalogTitle))) || {}).id || 'gid://shopify/PriceList/PLATZHALTER';\n\nconst vorschlag = {\n  collectionBuecher: findCol(/b(\\u00fc|ue)cher/i),\n  collectionMerch: findCol(/merch/i),\n  priceListAT: findPl('EUR', /AT|\\u00d6sterreich|Austria/i),\n  priceListCH: findPl('CHF', /CH|Schweiz|Switzerland/i)\n};\n\nreturn [{\n  json: {\n    priceLists: plOut,\n    collections: colOut,\n    configVorschlag: vorschlag\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        912,
        304
      ],
      "id": "b8372b06-b721-4d91-adfc-764d21c131e5",
      "name": "IDs aufbereiten",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "content": "## Katalog-IDs auslesen\nZieht aus vdzvc0-nd:\n- **PriceLists** (id, name, currency, Katalog-Titel) → AT/CH zuordnen\n- **Collections** (id, title, handle) → Bücher/Merch zuordnen\n\nOutput-Node \"IDs aufbereiten\": Feld `configVorschlag` enthält einen Best-Guess (Heuristik über Währung/Titel) — vor Übernahme prüfen.\n\nBenötigter Scope: `read_products`.",
        "height": 300,
