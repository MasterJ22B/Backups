    {
      "parameters": {
        "jsCode": "const db = $input.first().json || {};\nconst quelle = $('Ausgabe fehlerhafte Kunden').item.json;\n\nconst vorname = (db.Vorname || '').trim();\nconst nachname = (db.Nachname || '').trim();\nconst found = !!(vorname && nachname);\n\nreturn [{\n  json: {\n    found,\n    customerId: quelle.customerId,\n    email: quelle.email,\n    firstName: vorname || null,\n    lastName: nachname || null,\n  },\n}];"
      },
