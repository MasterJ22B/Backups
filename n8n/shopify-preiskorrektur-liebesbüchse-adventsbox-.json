        "jsCode": "const shop = 'vdzvc0-nd';\n\n// Part B: ab 30.06.2026 (offen, keine Obergrenze)\nconst sinceB = '2026-06-30T00:00:00Z';\n\nconst initUrl = `https://${shop}.myshopify.com/admin/api/2024-10/orders.json`\n  + `?limit=250`\n  + `&status=any`\n  + `&created_at_min=${encodeURIComponent(sinceB)}`\n  + `&since_id=0`\n  + `&fields=id,name,created_at,tags,line_items`;\n\nconst staticData = $getWorkflowStaticData('global');\n// NICHT leeren: Ergebnisse aus Part A bleiben erhalten, B haengt an.\nif (!Array.isArray(staticData.toFix)) {\n  staticData.toFix = [];\n}\n\nreturn [{\n  json: {\n    nextUrl: initUrl,\n    hasNext: true,\n    accessToken: $('Token holen  (B)').item.json.access_token\n  }\n}];"
