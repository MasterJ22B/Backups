        "jsCode": "const shop = 'vdzvc0-nd';\n\n// >>> HIER die Bestell-ID händisch eintragen <<<\nconst orderId = '7492893606003';\n\nconst url = `https://${shop}.myshopify.com/admin/api/2024-10/orders/${orderId}.json`;\n\nreturn [{\n  json: {\n    orderUrl: url,\n    accessToken: $('Token holen ').item.json.access_token\n  }\n}];"
