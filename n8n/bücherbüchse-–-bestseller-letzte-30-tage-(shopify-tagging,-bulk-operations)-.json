        "url": "=https://{{ $('Konfiguration').first().json.shopDomain }}/admin/api/2026-07/graphql.json",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "shopifyAccessTokenApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ query: `query($tagQuery: String!) { products(first: 250, query: $tagQuery) { edges { node { id } } } }`, variables: { tagQuery: `tag:'${$('Konfiguration').first().json.tagName}'` } }) }}",
        "options": {}
      },
      "id": "73c138e0-d50d-4381-b5b3-15377d45f262",
      "name": "Aktuell getaggte Produkte abrufen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
