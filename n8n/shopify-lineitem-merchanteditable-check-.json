      "id": "1db6365f-b429-4998-af9a-8b960cd2d83d",
      "name": "GraphQL Order abfragen"
    },
    {
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst errs = resp?.errors;\nif (errs) {\n  throw new Error('GraphQL errors: ' + JSON.stringify(errs));\n}\n\nconst order = resp?.data?.order;\nif (!order) {\n  throw new Error('Keine Order erhalten: ' + JSON.stringify(resp));\n}\n\nconst edges = order.lineItems?.edges || [];\n\nreturn edges.map(e => {\n  const n = e.node;\n  return {\n    json: {\n      orderName: order.name,\n      lineItemId: n.id,\n      title: n.title,\n      sku: n.sku,\n      quantity: n.quantity,\n      merchantEditable: n.merchantEditable,\n      preis: n.originalUnitPriceSet?.shopMoney?.amount ?? null,\n      waehrung: n.originalUnitPriceSet?.shopMoney?.currencyCode ?? null,\n      hatContract: !!n.contract?.id,\n      sellingPlan: n.sellingPlan?.name ?? null\n    }\n  };\n});"
      },
