    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\nWITH KundenDaten AS\n(\n    SELECT\n        a.cMail AS EmailAdresse,\n        a.cVorname AS Vorname,\n        a.cName AS Nachname,\n        a.cLand AS Land,\n        a.cPLZ AS Postleitzahl,\n        a.cTel AS Telefonnummer,\n        ROW_NUMBER() OVER\n        (\n            PARTITION BY a.cMail\n            ORDER BY a.cTel\n        ) AS rn\n    FROM dbo.tAdresse AS a\n    WHERE a.cMail IS NOT NULL\n      AND LTRIM(RTRIM(a.cMail)) <> ''\n      AND EXISTS\n      (\n          SELECT 1\n          FROM dbo.tBestellung AS b\n          WHERE b.tKunde_kKunde = a.kKunde\n            AND b.cBestellNr NOT LIKE 'LEAF-%'\n            AND b.cBestellNr NOT LIKE 'CINNA-%'\n            AND b.cBestellNr NOT LIKE 'A-%'\n      )\n)\nSELECT COUNT(*) AS total\nFROM KundenDaten\nWHERE rn = 1;\n",
        "options": {}
      },
      "type": "n8n-nodes-base.microsoftSql",
      "typeVersion": 1.1,
      "position": [
        -240,
        32
      ],
      "id": "88e5777f-fd84-4780-ba29-8eaf397d0889",
      "name": "Microsoft SQL – Count",
