    {
      "parameters": {
        "method": "POST",
        "url": "=https://{{ $('Config').first().json.shop }}.myshopify.com/admin/api/{{ $('Config').first().json.apiVersion }}/graphql.json",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Shopify-Access-Token",
              "value": "={{ $('Token holen').first().json.access_token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ query: \"query($q: String!, $cursor: String) {\\n  orders(first: 50, after: $cursor, query: $q, sortKey: CREATED_AT) {\\n    pageInfo { hasNextPage endCursor }\\n    nodes {\\n      id\\n      name\\n      createdAt\\n      fulfillments(first: 10) {\\n        id\\n        status\\n        displayStatus\\n        deliveredAt\\n        trackingInfo(first: 5) { number company }\\n      }\\n    }\\n  }\\n}\", variables: { q: $('Config').first().json.shopifyQuery, cursor: $json.cursor } }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1072,
        416
      ],
      "id": "57c269c3-c629-458f-8f37-1cf982cb20d2",
      "name": "Shopify: Bestellungen holen",
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const res = $input.first().json;\nif (res.errors) throw new Error('Shopify GraphQL: ' + JSON.stringify(res.errors));\nconst data = res.data.orders;\nconst s = $getWorkflowStaticData('global');\n\n// Diese Status brauchen kein \"geliefert\" mehr\nconst ignorieren = ['DELIVERED', 'CANCELED', 'FAILURE', 'PICKED_UP', 'LABEL_VOIDED'];\n\nfor (const order of data.nodes) {\n  for (const f of order.fulfillments || []) {\n    if (f.status !== 'SUCCESS') continue;\n    if (f.deliveredAt || ignorieren.includes(f.displayStatus)) continue;\n    const t = (f.trackingInfo || []).find(x => x.number);\n    if (!t) continue; // ohne Sendungsnummer kein Abgleich möglich\n    s.kandidaten.push({\n      orderId: order.id,\n      orderName: order.name,\n      orderDatum: order.createdAt,\n      fulfillmentId: f.id,\n      fulfillmentStatus: f.displayStatus,\n      trackingNummer: String(t.number).replace(/\\s/g, ''),\n      carrier: t.company || '',\n    });\n  }\n}\n\nreturn [{ json: {\n  cursor: data.pageInfo.endCursor,\n  hasNext: data.pageInfo.hasNextPage,\n  bisherGesammelt: s.kandidaten.length,\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
