    {
      "parameters": {
        "jsCode": "const shop = 'vdzvc0-nd';\n\nconst initUrl = `https://${shop}.myshopify.com/admin/api/2024-10/customers.json`\n  + `?limit=250`\n  + `&fields=id,email,first_name,last_name`;\n\n// Globales Array leeren\nconst staticData = $getWorkflowStaticData('global');\nstaticData.toFix = [];\n\nreturn [{\n  json: {\n    nextUrl: initUrl,\n    hasNext: true,\n    accessToken: $('Token holen ').item.json.access_token\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -240,
