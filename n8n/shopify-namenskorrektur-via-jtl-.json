    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT TOP 1\n    AuftragAdresse.cVorname AS Vorname,\n    AuftragAdresse.cName    AS Nachname,\n    AuftragAdresse.cMail    AS Mail\nFROM [eazybusiness].Verkauf.tAuftrag Auftrag\nINNER JOIN [eazybusiness].Verkauf.tAuftragAdresse AuftragAdresse\n    ON AuftragAdresse.kAuftrag = Auftrag.kAuftrag\n    AND AuftragAdresse.nTyp = 1\nWHERE AuftragAdresse.cMail = '{{ $json.email }}'\n    AND AuftragAdresse.cVorname <> ''\n    AND AuftragAdresse.cName <> ''\nORDER BY Auftrag.dErstellt DESC;\n",
        "options": {}
      },
