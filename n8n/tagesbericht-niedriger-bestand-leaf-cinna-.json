      {
        "parameters": {
          "jsCode": "const shop = 'hfmtrs-bh';\n\nconst initUrl = `https://${shop}.myshopify.com/admin/api/2024-10/products.json`\n  + `?limit=250`\n  + `&fields=id,title,variants`;\n\n// Globales Array leeren\nconst staticData = $getWorkflowStaticData('global');\nstaticData.lowStock = [];\n\nreturn [{\n  json: {\n    nextUrl: initUrl,\n    hasNext: true\n  }\n}];"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
