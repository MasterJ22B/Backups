      "name": "Hole Profile aus \"inaktiv\" Segment "
    },
    {
      "parameters": {
        "jsCode": "// Äußere Response aus dem HTTP-Node\nconst wrapper = $json;\n\n// globale Workflow-Daten holen\nconst staticData = $getWorkflowStaticData('global');\n\nif (typeof staticData.deletedCount !== 'number') {\n  staticData.deletedCount = 0;\n}\nif (!Array.isArray(staticData.debugEmailsAll)) {\n  staticData.debugEmailsAll = [];\n}\nif (!Array.isArray(staticData.debugEmailsUnique)) {\n  staticData.debugEmailsUnique = [];\n}\nif (!Array.isArray(staticData.debugNextUrls)) {\n  staticData.debugNextUrls = [];\n}\nif (!Array.isArray(staticData.debugDuplicateEmails)) {\n  staticData.debugDuplicateEmails = [];\n}\n\n// Eigentliche API-Response bestimmen\nlet response = wrapper;\n\n// Falls die Response in wrapper.data als JSON-String steckt -> parsen\nif (typeof wrapper.data === 'string') {\n  try {\n    response = JSON.parse(wrapper.data);\n  } catch (error) {\n    staticData.nextUrl = null;\n\n    return [\n      {\n        json: {\n          found: false,\n          parseError: true,\n          message: 'Response konnte nicht geparst werden',\n          rawData: wrapper.data,\n          deletedCount: staticData.deletedCount,\n        },\n      },\n    ];\n  }\n}\n\n// Falls wrapper.data schon ein Objekt ist, dieses verwenden\nelse if (wrapper.data && typeof wrapper.data === 'object') {\n  response = wrapper.data;\n}\n\n// Jetzt normal auf Klaviyo-Struktur zugreifen\nconst profiles = Array.isArray(response.data) ? response.data : [];\nconst nextUrl = response.links?.next || null;\n\n// nextUrl global speichern\nstaticData.nextUrl = nextUrl;\n\n// verwendete nextUrl debuggen\nif (nextUrl) {\n  staticData.debugNextUrls.push(nextUrl);\n}\n\n// Keine Profile mehr gefunden\nif (profiles.length === 0) {\n  return [\n    {\n      json: {\n        found: false,\n        message: 'Keine Profile mehr gefunden',\n        deletedCount: staticData.deletedCount,\n      },\n    },\n  ];\n}\n\n// Counter erhöhen\nstaticData.deletedCount += profiles.length;\n\n// Debug: E-Mails sammeln und Dopplungen prüfen\nconst uniqueEmails = new Set(staticData.debugEmailsUnique);\nconst duplicateEmails = new Set(staticData.debugDuplicateEmails);\n\nfor (const profile of profiles) {\n  const attrs = profile.attributes || {};\n  const email = attrs.email || null;\n\n  if (!email) continue;\n\n  // alle E-Mails speichern\n  staticData.debugEmailsAll.push(email);\n\n  // Duplikate prüfen\n  if (uniqueEmails.has(email)) {\n    duplicateEmails.add(email);\n  } else {\n    uniqueEmails.add(email);\n  }\n}\n\n// Arrays zurückschreiben\nstaticData.debugEmailsUnique = Array.from(uniqueEmails);\nstaticData.debugDuplicateEmails = Array.from(duplicateEmails);\n\n// Profile als einzelne Items zurückgeben\nreturn profiles.map(profile => {\n  const attrs = profile.attributes || {};\n\n  return {\n    json: {\n      found: true,\n      profileId: profile.id,\n      email: attrs.email,\n      deletedCount: staticData.deletedCount,\n      isNewPage: true,\n    },\n  };\n});"
      },
