      "id": "3777011f-e435-4a5f-8a64-fd9d4ee5039b",
      "name": "JSONL herunterladen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1200,
        976
      ]
    },
    {
      "parameters": {
        "jsCode": "const rawItem = $input.first().json;\nconst raw = typeof rawItem === 'string' ? rawItem : (rawItem.data ?? JSON.stringify(rawItem));\nconst topN = $('Konfiguration').first().json.topN;\nconst productSales = {};\n\nconst lines = raw.split('\\n').filter(l => l.trim().length > 0);\nfor (const line of lines) {\n  let row;\n  try {\n    row = JSON.parse(line);\n  } catch (e) {\n    continue;\n  }\n  const productId = row.product?.id;\n  if (!productId || typeof row.quantity !== 'number') continue;\n  productSales[productId] = (productSales[productId] || 0) + row.quantity;\n}\n\nconst sorted = Object.entries(productSales)\n  .sort((a, b) => b[1] - a[1])\n  .slice(0, topN)\n  .map(([productId, quantity]) => ({ json: { productId, quantity } }));\n\nreturn sorted;"
      },
      "id": "7f4f2808-6904-4e7d-91a4-e9e05f83de43",
      "name": "JSONL parsen & Top N ermitteln",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -992,
        976
      ]
    },
    {
