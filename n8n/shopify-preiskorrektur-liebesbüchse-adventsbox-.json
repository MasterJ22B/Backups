        "jsCode": "const resp = $input.first().json;\nconst add = resp?.data?.orderEditAddVariant;\nconst errs = add?.userErrors || [];\nif (errs.length) {\n  throw new Error('orderEditAddVariant userErrors: ' + JSON.stringify(errs));\n}\n\nreturn [{\n  json: {\n    calcOrderId: $('CalcOrder auslesen').item.json.calcOrderId,\n    orderName: $('CalcOrder auslesen').item.json.orderName,\n    oldLineItemGid: $('CalcOrder auslesen').item.json.oldLineItemGid,\n    orderGid: $('CalcOrder auslesen').item.json.orderGid,\n    addedLineItem: add?.calculatedLineItem || null\n  }\n}];"
