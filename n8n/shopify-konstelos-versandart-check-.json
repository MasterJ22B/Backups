    {
      "parameters": {
        "jsCode": "const shop = 'vdzvc0-nd';\n\n// Alle Bestellungen, Pagination in 50er-Schritten\nconst initUrl = `https://${shop}.myshopify.com/admin/api/2024-10/orders.json`\n  + `?limit=250`\n  + `&status=any`\n  + `&order=created_at+desc`\n  + `&fields=id,name,created_at,shipping_lines`;\n\n// Globales Array leeren\nconst staticData = $getWorkflowStaticData('global');\nstaticData.toFix = [];\n\nreturn [{\n  json: {\n    nextUrl: initUrl,\n    hasNext: true,\n    accessToken: $('Token holen ').item.json.access_token\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2752,
        848
      ],
      "id": "3c908c9b-15b7-45fd-a989-46b9514a7621",
      "name": "Array leeren + Start URL setzen"
    },
    {
      "parameters": {
        "url": "={{ $json.nextUrl }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": []
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Shopify-Access-Token",
              "value": "={{ $json.accessToken }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        3040,
        848
      ],
      "id": "c8fe53ae-36b3-46a1-b6da-fb1f63068d51",
      "name": "GET Bestellungen ",
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst orders = response.body?.orders || response.orders || [];\nconst linkHeader = response.headers?.link || '';\n\nconst staticData = $getWorkflowStaticData('global');\nif (!Array.isArray(staticData.toFix)) {\n  staticData.toFix = [];\n}\n\n// Prüft, ob eine Bestellung die Versandart \"Konstelos\" trägt\nfor (const order of orders) {\n  const shippingLines = order.shipping_lines || [];\n\n  const konstelosLines = shippingLines.filter(sl =>\n    String(sl.title || '').trim().toLowerCase() === 'konstelos'\n  );\n\n  if (konstelosLines.length > 0) {\n    staticData.toFix.push({\n      orderId: order.id,\n      orderName: order.name,\n      createdAt: order.created_at,\n      versandpositionen: konstelosLines.map(sl => ({\n        shippingLineId: sl.id,\n        title: sl.title,\n        code: sl.code,\n        price: sl.price,\n      })),\n    });\n  }\n}\n\n// Next URL extrahieren\nconst nextMatch = linkHeader\n  .split(',')\n  .find(s => s.includes('rel=\"next\"'));\nconst nextUrl = nextMatch ? nextMatch.match(/<(.+?)>/)?.[1] : null;\n\nreturn [{\n  json: {\n    nextUrl: nextUrl,\n    hasNext: !!nextUrl,\n    collectedCount: staticData.toFix.length\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
