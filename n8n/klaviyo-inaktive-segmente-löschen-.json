    {
      "parameters": {
        "jsCode": "// 1) Wrapper aus dem HTTP-Node holen\nconst wrapper = $json;\nlet response = wrapper.data;\n\n// 2) Falls das innere 'data' ein String ist: parsen\nif (typeof response === 'string') {\n  try {\n    response = JSON.parse(response);\n  } catch (error) {\n    return [\n      {\n        json: {\n          found: false,\n          parseError: true,\n          errorMessage: String(error),\n          rawWrapper: wrapper,\n          deletedCount: $getWorkflowStaticData('global').deletedCount || 0,\n        },\n      },\n    ];\n  }\n}\n\n// 3) Workflow-weiten Counter holen\nconst staticData = $getWorkflowStaticData('global');\n\nif (typeof staticData.deletedCount !== 'number') {\n  staticData.deletedCount = 0;\n}\n\n// 4) Profiles aus der Klaviyo-Response ziehen\nconst profiles = Array.isArray(response.data) ? response.data : [];\n\n// 5) Abbruchbedingung: nichts mehr gefunden\nif (profiles.length === 0) {\n  return [\n    {\n      json: {\n        found: false,\n        message: 'Keine Profile mehr gefunden',\n        deletedCount: staticData.deletedCount,\n      },\n    },\n  ];\n}\n\n// 6) Anzahl der jetzt gefundenen Profile zum Counter addieren\nstaticData.deletedCount += profiles.length;\n\n// 7) Profile als Items zurückgeben\nreturn profiles.map(profile => {\n  const attrs = profile.attributes || {};\n\n  return {\n    json: {\n      found: true,\n      profileId: profile.id,\n      email: attrs.email,\n      deletedCount: staticData.deletedCount,\n    },\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        -288
      ],
      "id": "f088ada6-4cae-4520-91a3-2b46f7866055",
