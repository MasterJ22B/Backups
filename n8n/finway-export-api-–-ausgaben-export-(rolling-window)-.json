    {
      "parameters": {
        "jsCode": "// Stabilen Schlüssel festlegen: Spaltenname der Beleg-/Antrags-ID aus der finway-CSV eintragen.\nconst KEY_COLUMN = 'HIER_ID_SPALTE';\nconst meta = $('Export-ID merken').last().json;\nconst now = new Date().toISOString().slice(0, 19).replace('T', ' ');\nreturn $input.all().map(i => {\n  const row = i.json;\n  const key = row[KEY_COLUMN] ?? JSON.stringify(row);\n  return { json: {\n    row_key: String(key).slice(0, 190),\n    export_id: meta.exportId,\n    export_from: meta.from,\n    export_to: meta.to,\n    last_seen_at: now,\n    payload: JSON.stringify(row)\n  } };\n});"
      },
