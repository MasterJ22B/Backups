    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// nur echte Bestands-Items (mit produkt-Feld)\nconst rows = items.filter(item => item.json && item.json.produkt !== undefined);\n\nif (rows.length === 0) {\n  return [{\n    json: {\n      mailText: `<p>Es wurden keine Produkte/Varianten mit einem Bestand unter 0 gefunden.</p>\n<p>Mit freundlichen Grüßen<br>Jesse's n8n-Workflow</p>`,\n    },\n  }];\n}\n\nconst escapeHtml = (value) => {\n  return String(value ?? '')\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;')\n    .replace(/'/g, '&#039;');\n};\n\nconst sortiert = rows\n  .map(item => item.json)\n  .sort((a, b) => Number(a.bestand) - Number(b.bestand));\n\nconst tabellenZeilen = sortiert.map(row => {\n  return `\n    <tr>\n      <td>${escapeHtml(row.produkt)}</td>\n      <td>${escapeHtml(row.variante)}</td>\n      <td>${escapeHtml(row.sku)}</td>\n      <td align=\"right\">${escapeHtml(row.bestand)}</td>\n    </tr>\n  `;\n}).join('');\n\nconst mailText = `\n<p>Folgende Produkt-Varianten sind ausverkauft/haben einen Bestand unter 0:</p>\n\n<table border=\"1\" cellpadding=\"6\" cellspacing=\"0\" style=\"border-collapse: collapse; font-family: Arial, sans-serif; font-size: 14px;\">\n  <thead>\n    <tr>\n      <th align=\"left\">Produkt</th>\n      <th align=\"left\">Variante</th>\n      <th align=\"left\">SKU</th>\n      <th align=\"right\">Bestand</th>\n    </tr>\n  </thead>\n  <tbody>\n    ${tabellenZeilen}\n  </tbody>\n</table>\n<br>\n<p>Die Daten dieser Auswertung beziehen sich nur auf Shopify!</p>\n<br>\n<p>Mit freundlichen Grüßen<br>Jesse's n8n-Workflow</p>\n`;\n\nreturn [{\n  json: {\n    mailText,\n    anzahl: sortiert.length,\n  },\n}];\n"
      },
