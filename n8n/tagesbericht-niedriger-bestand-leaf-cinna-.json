      "id": "d97f4607-281c-4129-893e-0f5269f1b768",
      "name": "GET Produkte ",
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst products = response.body?.products || response.products || [];\nconst linkHeader = response.headers?.link || '';\n\nconst staticData = $getWorkflowStaticData('global');\nif (!Array.isArray(staticData.lowStock)) {\n  staticData.lowStock = [];\n}\n\n// Varianten mit Bestand <= 0 sammeln (Gutscheinkarte ausgenommen)\nfor (const product of products) {\n  if (product.title === 'Gutscheinkarte') {\n    continue;\n  }\n  const variants = product.variants || [];\n  for (const variant of variants) {\n    const qty = Number(variant.inventory_quantity ?? 0);\n    if (qty <= 0) {\n      staticData.lowStock.push({\n        produkt: product.title,\n        variante: variant.title,\n        sku: variant.sku || null,\n        bestand: qty,\n      });\n    }\n  }\n}\n\n// Next URL extrahieren\nconst nextMatch = linkHeader\n  .split(',')\n  .find(s => s.includes('rel=\"next\"'));\nconst nextUrl = nextMatch ? nextMatch.match(/<(.+?)>/)?.[1] : null;\n\nreturn [{\n  json: {\n    nextUrl: nextUrl,\n    hasNext: !!nextUrl,\n    collectedCount: staticData.lowStock.length\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        128
      ],
      "id": "a906e2f9-ec0b-481a-80ba-da8ee42f8c38",
