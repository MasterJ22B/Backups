    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Pakete = alle Items, die eine cAuftragsNr mitbringen\nconst pakete = items.filter(item => item.json && item.json.cAuftragsNr);\n\nif (pakete.length === 0) {\n  return [{\n    json: {\n      mailText: `<p>Es wurden keine externen Auftragsnummern angepasst.</p>\n<p>Mit freundlichen Grüßen<br>Jesse's n8n-Workflow</p>`,\n    },\n  }];\n}\n\nconst listenEintraege = pakete\n  .map(item => `  <li>${item.json.cAuftragsNr}</li>`)\n  .join('\\n');\n\nconst mailText = `\n<p>Folgende Auftragsnummern der BB-Abos wurden vom n8n-Workflow angepasst:</p>\n\n<ul style=\"font-family: Arial, sans-serif; font-size: 14px; line-height: 1.6;\">\n${listenEintraege}\n</ul>\n\n<p>Mit freundlichen Grüßen<br>Jesse's n8n-Workflow</p>\n`;\n\nreturn [{\n  json: {\n    mailText,\n  },\n}];\n"
      },
