      "parameters": {
        "jsCode": "const shop = 'vdzvc0-nd';\n\n// Part A: 30.05.2026 bis 26.06.2026 (exklusiv)\nconst sinceA = '2026-05-30T00:00:00Z';\nconst untilA = '2026-06-26T00:00:00Z';\n\nconst initUrl = `https://${shop}.myshopify.com/admin/api/2024-10/orders.json`\n  + `?limit=250`\n  + `&status=any`\n  + `&created_at_min=${encodeURIComponent(sinceA)}`\n  + `&created_at_max=${encodeURIComponent(untilA)}`\n  + `&since_id=0`\n  + `&fields=id,name,created_at,tags,line_items`;\n\nconst staticData = $getWorkflowStaticData('global');\nstaticData.toFix = [];\n\nreturn [{\n  json: {\n    nextUrl: initUrl,\n    hasNext: true,\n    accessToken: $('Token holen ').item.json.access_token\n  }\n}];"
      },
