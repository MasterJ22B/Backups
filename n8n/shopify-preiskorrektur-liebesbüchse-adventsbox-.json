    {
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst begin = resp?.data?.orderEditBegin;\nconst errs = begin?.userErrors || [];\nif (errs.length) {\n  throw new Error('orderEditBegin userErrors: ' + JSON.stringify(errs));\n}\nconst calcOrderId = begin?.calculatedOrder?.id;\nif (!calcOrderId) {\n  throw new Error('Keine calculatedOrder.id erhalten: ' + JSON.stringify(resp));\n}\n\nreturn [{\n  json: {\n    calcOrderId,\n    oldLineItemGid: $('Loop Over Items').item.json.oldLineItemGid,\n    orderName: $('Loop Over Items').item.json.orderName,\n    orderGid: $('Loop Over Items').item.json.orderGid,\n    variantId: $('Loop Over Items').item.json.variantId\n  }\n}];"
