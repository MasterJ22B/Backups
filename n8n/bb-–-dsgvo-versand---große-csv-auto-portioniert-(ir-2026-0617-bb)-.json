    {
      "parameters": {
        "jsCode": "const s=$getWorkflowStaticData('global');\ns.ok=s.ok||0;s.fail=s.fail||0;s.failRows=s.failRows||[];\nfor(const it of $input.all()){const j=it.json;\n  if(j.ok){s.ok++;}else{s.fail++;if(s.failRows.length<5000){s.failRows.push({email:j.email,http_status:j.http_status,sent_at:j.sent_at});}}\n}\nreturn $input.all();"
      },
