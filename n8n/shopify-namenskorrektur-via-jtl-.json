      "parameters": {
        "jsCode": "// Code Node nach Merge: Token an jedes Kunden-Item hängen\nconst items = $input.all();\n\n// Token-Item identifizieren (hat access_token, aber keine customerId)\nconst tokenItem = items.find(i => i.json.access_token && !i.json.customerId);\nconst accessToken = tokenItem\n  ? tokenItem.json.access_token\n  : $('Token holen 2').first().json.access_token;\n\n// Alle echten Kunden-Items (haben customerId) mit Token anreichern\nreturn items\n  .filter(i => i.json.customerId)\n  .map(i => ({\n    json: {\n      customerId: i.json.customerId,\n      email: i.json.email,\n      firstName: i.json.firstName,\n      lastName: i.json.lastName,\n      accessToken: accessToken,\n    },\n  }));"
      },
